{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE '\"file_path\"[[:space:]]*:[[:space:]]*\"[^\"]*\\.org\"' && ERROR_ON_WARN=t make lisp",
            "timeout": 60,
            "statusMessage": "Tangling .org file..."
          }
        ]
      }
    ]
  }
}
